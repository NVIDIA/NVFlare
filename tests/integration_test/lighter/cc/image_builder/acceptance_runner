set -eu
test_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository=$(CDPATH='' cd -- "$test_directory/../../../../.." && pwd)
builder_directory=$repository/nvflare/lighter/cc/image_builder
if [ -n "${CVM_BUILDER_PYTHON:-}" ]; then
    python=$CVM_BUILDER_PYTHON
elif [ -x "$builder_directory/.venv/bin/python" ]; then
    python=$builder_directory/.venv/bin/python
else
    python=python3
fi
exec "$python" "$test_directory/acceptance_runner.py" "$@"
