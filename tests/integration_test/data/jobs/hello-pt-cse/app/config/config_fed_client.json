          "params_transfer_type": "FULL",
          "train_with_evaluation": true,
          "train_task_name": "train",
          "evaluate_task_name": "validate",
          "submit_model_task_name": "submit_model"
        }
      }
    }
  ],
  "task_data_filters": [],
  "task_result_filters": [],
  "components": []
}
