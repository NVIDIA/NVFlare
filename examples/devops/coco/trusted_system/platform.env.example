# Run measurement capture on the selected preinstalled worker while it is under
# the trusted platform owner's control. No cluster/runtime/Trustee setup is performed.
NODE_NAME=""
RUNTIME_CLASS="kata-qemu-nvidia-gpu-snp"
# Also supported: kata-qemu-snp, kata-qemu-tdx, kata-qemu-nvidia-gpu-tdx.
KUBECONFIG_PATH="${HOME}/.kube/config"
INSTALLED_KATA_CONFIG="/opt/kata/share/defaults/kata-containers/configuration-qemu-nvidia-gpu-snp.toml"
KATA_RUNTIME="/opt/kata/bin/kata-runtime"
# The existing runtime must support this example's Kata/genpolicy 3.29.0 interface.
# Public collector inputs; no publisher credential belongs on this worker.
COLLECTOR_IMAGE="registry.example.com/coco/collector-snp@sha256:REPLACE_WITH_PUBLISHED_DIGEST"
COLLECTOR_METADATA_FILE="${HOME}/private-platform/collector-image.json"
COLLECTOR_REGISTRY_CA="${HOME}/private-platform/registry-ca.crt"
# Optional received-file checksum. No separate authentication channel is required.
COLLECTOR_METADATA_SHA256=""
# SNP only: an existing reviewed snpguest executable and independent uint8 TCB floors.
SNP_VERIFIER="/usr/local/bin/snpguest"
SNP_MIN_REPORTED_TCB_BOOTLOADER=""
SNP_MIN_REPORTED_TCB_TEE=""
SNP_MIN_REPORTED_TCB_SNP=""
SNP_MIN_REPORTED_TCB_MICROCODE=""
# TDX only: an existing reviewed Trustee/DCAP evidence verifier executable.
TDX_VERIFIER=""
