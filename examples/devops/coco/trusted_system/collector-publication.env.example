# Trusted owner/provisioning machine only. Never copy publisher credentials to a worker.
CPU_TEE="snp"  # snp or tdx; the same CPU collector supports CPU-only and GPU targets.
COLLECTOR_REGISTRY_REPOSITORY="registry.example.com/coco/collector"
COLLECTOR_REGISTRY_CA="${HOME}/private-platform-reference/registry-ca.crt"
COLLECTOR_REGISTRY_AUTH_FILE="${HOME}/private-platform-reference/registry-auth.json"
