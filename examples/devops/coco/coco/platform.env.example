# Copy to platform.env (mode 0600); review before running. This is sourced shell code.
# Set the exact FQDN returned by hostname -f on the intended machine.
EXPECTED_HOSTNAME=""

# Vendored bootstrap stages; no external NVFlare checkout is required.
COCO_CONFIG="${HOME}/.config/coco-platform/config.env"
COCO_STATE_DIR="${HOME}/.local/state/coco-platform"

SERVICE_FQDN="secure-services.example.com"
REGISTRY_PORT="5000"
REGISTRY_HOST="${SERVICE_FQDN}:${REGISTRY_PORT}"
# Select the same runtime as config.env and the workload-owner handoff:
# kata-qemu-snp, kata-qemu-nvidia-gpu-snp, kata-qemu-tdx, or kata-qemu-nvidia-gpu-tdx.
# This installs public runtime bits; it does not approve measurements in RVPS.
RUNTIME_CLASS="kata-qemu-nvidia-gpu-snp"
KUBECONFIG_PATH="/etc/kubernetes/admin.conf"
