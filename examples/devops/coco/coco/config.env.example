# Private config.env: set the intended machine hostname -f.
EXPECTED_HOSTNAME=""
KUBERNETES_MINOR=v1.34
KUBERNETES_VERSION=1.34.9-1.1
KUBERNETES_SEMVER=v1.34.9
# Approved primary fingerprint of the Kubernetes OBS repository signing key.
KUBERNETES_APT_KEY_FINGERPRINT=DE15B14486CD377B9E876E1A234654DA9A296436
CONTAINERD_VERSION=2.2.2
CONTAINERD_SHA256=2c08c99cbde73b3388c6d5da68e0bcaebc70c9174f2b14d785695e4401b3ede0
CNI_PLUGINS_VERSION=v1.8.0
# Reviewed linux-amd64 release digest; update version and pin together.
CNI_PLUGINS_SHA256=ab3bda535f9d90766cccc90d3dddb5482003dd744d7f22bcf98186bf8eea8be6
HELM_VERSION=v3.21.3
HELM_SHA256=15e041a93a590dce8100f39385cd98c84a765c9e36aeeb9e2dc6ff9e4769e2e0
CALICO_VERSION=v3.32.1
CALICO_SHA256=a1df919d9721cf667accdc3e72848911b0cb25cfab7d2478ad0c996302c95744
KATA_VERSION=3.29.0
GPU_OPERATOR_VERSION=v26.3.1
NODE_IP=
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
CLUSTER_DNS=10.96.0.10
KUBECONFIG_PATH=/etc/kubernetes/admin.conf
GPU_RESOURCE=nvidia.com/pgpu
# GPU_COUNT must be 0 for kata-qemu-snp/tdx, or 1 for either nvidia-gpu runtime.
GPU_COUNT=1
ALLOW_PACKAGE_DOWNGRADES=0
IGNORE_CHECKSUM_MISMATCH=0
# Use snp or tdx to match the explicitly selected RuntimeClass. CPU-only runtime
# installation does not require NVIDIA, VFIO, IOMMU passthrough, or GPU Operator.
TEE_PLATFORM=snp
# kata-qemu-snp | kata-qemu-nvidia-gpu-snp | kata-qemu-tdx | kata-qemu-nvidia-gpu-tdx
RUNTIME_CLASS=kata-qemu-nvidia-gpu-snp
# For TDX only: preinstall the reviewed Intel DCAP tdx-qgs package, configure
# Intel collateral access and qgsd to match the pinned runtime's QGS endpoint.
# Stage 00 checks the exact package/config pins; stage 20 also checks transport.
QGS_PACKAGE_VERSION=
QGS_CONFIG_SHA256=
QGS_QCNL_CONFIG_SHA256=
