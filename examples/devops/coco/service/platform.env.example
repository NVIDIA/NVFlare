# Copy to platform.env (mode 0600); review before running. This is sourced shell code.
# Set the exact FQDN returned by hostname -f on the intended machine.
EXPECTED_HOSTNAME=""

# Pinned post-v0.21 Trustee snapshot selected on 2026-08-27.
SERVICE_FQDN="secure-services.example.com"

TRUSTEE_REPOSITORY="https://github.com/confidential-containers/trustee.git"
TRUSTEE_COMMIT="338610fbfed57b66c61a8a3a60e0e4386bdce793"
TRUSTEE_LABEL="main-338610f"
TRUSTEE_ROOT="${HOME}/trustee-main-338610f"
TRUSTEE_PROJECT="trustee-main-338610f"

ACTIX_HTTP_VERSION="3.13.3"
ACTIX_HTTP_SHA256="11004b0e9b44b4eb3d15e0c3132b96fb178c7e50a74758b2f17bb9cc9a7fb4f6"

RUST_BUILDER="docker.io/library/rust@sha256:f49565f188ee00bc2a18dd418183f2c5f23ef7d6e691890517ed341a598f67c3"
UBUNTU_RUNTIME="ubuntu@sha256:7c06e91f61fa88c08cc74f7e1b7c69ae24910d745357e0dfe1d2c0322aaf20f9"
SETUP_IMAGE="alpine/openssl@sha256:7ca28a8cfa05375bc0139b580654c7eec45ea322c066a5189a50f8be457f22b0"
KBS_IMAGE="coco-kbs-grpc-as:${TRUSTEE_LABEL}-actix-head-128k"
AS_IMAGE="coco-as-grpc:${TRUSTEE_LABEL}"
RVPS_IMAGE="coco-rvps:${TRUSTEE_LABEL}"

KBS_URL="https://${SERVICE_FQDN}:8443"
TRUSTEE_TLS_DIR="/etc/trustee/tls"
TRUSTEE_PUBLIC_CERT="${HOME}/trustee-public.crt"

REGISTRY_PORT="5000"
REGISTRY_BACKEND_PORT="5001"
REGISTRY_IMAGE="docker.io/library/registry@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373"
REGISTRY_ROOT="/etc/coco-registry"
REGISTRY_DATA="/var/lib/coco-registry"
REGISTRY_PUBLISHER="coco-publisher"
# Registry clients learn Basic authentication only from the /v2/ ping.  The
# trusted admin origin is therefore challenged on every method, while other
# origins retain anonymous GET/HEAD and require credentials for mutations.
# Refresh this /32 from the admin operator before a later deployment.
REGISTRY_PUBLISHER_CIDR=""
PUBLISHER_DIR="${HOME}/.coco-publisher"

SNP_LAUNCH_MEASUREMENT=""

# REQUIRED before stage 09.  Each value is an independently approved minimum
# for the corresponding numeric `reported_tcb_*` claim in a signed SNP report.
# They are deliberately blank: do not learn or copy production floors from the
# adversarial CoCo node.  Establish them from the platform security owner's
# reviewed AMD firmware/microcode baseline and record that approval separately.
# Valid values are decimal integers from 0 through 255; 0 is a real SVN, not an
# "unset" sentinel.
SNP_MIN_REPORTED_TCB_BOOTLOADER=""
SNP_MIN_REPORTED_TCB_TEE=""
SNP_MIN_REPORTED_TCB_SNP=""
SNP_MIN_REPORTED_TCB_MICROCODE=""
