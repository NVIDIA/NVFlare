# Copy to platform.env. This is trusted executable shell configuration.
# Use an existing compatible Trustee; these helpers install no services or AS policies.
KBS_URL="https://trustee.example.com"
TRUSTEE_PUBLIC_CERT="${HOME}/coco-public/trustee-ca.pem"
ADMIN_TOKEN="${HOME}/coco-private/admin-credential"
KBS_CLIENT="kbs-client"
# Local receipts and reference-update lock; this is not Trustee backing storage.
STATE_DIR="${HOME}/.local/state/nvflare-coco-trustee"
# Needed only by workload registration (stage 12): the operator's current
# resource-policy export. All policy writers must use this same canonical file
# and serialize changes. No policy-content readback API is assumed.
CURRENT_RESOURCE_POLICY_FILE="${HOME}/coco-private/current-resource-policy.rego"
