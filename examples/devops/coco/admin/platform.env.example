# Copy to platform.env (mode 0600); review before running. This is sourced shell code.
# Set the exact FQDN returned by hostname -f on the intended machine.
EXPECTED_HOSTNAME=""

# Platform-owned values. Workload users must not change this file.
WORK_ROOT="${HOME}/coco-workload-owner"

REGISTRY_HOST="secure-services.example.com"
REGISTRY_PORT="5000"
REGISTRY_USERNAME="coco-publisher"
KBS_URL="https://secure-services.example.com:8443"

KATA_VERSION="3.29.0"
KATA_TOOLS_SHA256="d7b2b5d846fce3cd8136a28b7626d7b543bfcab5edea2bf8b37591af122f63fb"
KATA_TOOLS_URL="https://github.com/kata-containers/kata-containers/releases/download/3.29.0/kata-tools-static-3.29.0-amd64.tar.zst"

COSIGN_VERSION="v2.6.2"
COSIGN_SHA256="d437b8f0d30f5dec169337607fcfa0238de1348503e175f1bb5b94330b1ee409"
COSIGN_URL="https://github.com/sigstore/cosign/releases/download/v2.6.2/cosign-linux-amd64"

KEYPROVIDER_IMAGE="ghcr.io/confidential-containers/staged-images/coco-keyprovider@sha256:d694864d215c192c388ffa9645aea19f658fed961925489a1b6709cad201cf73"
RUNTIME_CLASS="kata-qemu-nvidia-gpu-snp"

# Trusted coordinator pins public/approved-workload-launch-profile.json after
# authenticating the trusted platform system handoff. Blank means generation MUST fail closed.
WORKLOAD_LAUNCH_PROFILE_SHA256=""

# Exact Kubernetes service variables observed on the target cluster. They are
# pinned because an adversarial cluster must not be allowed to add arbitrary
# environment variables to the protected process.
KUBERNETES_SERVICE_HOST="10.96.0.1"
KUBERNETES_SERVICE_PORT="443"
