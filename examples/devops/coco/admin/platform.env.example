# Copy to platform.env (mode 0600). These are trusted operator-controlled inputs.
WORK_ROOT="${HOME}/coco-workload-owner"

# Existing tools: Docker, Skopeo, Cosign, OpenSSL, jq and Python/PyYAML are on PATH.
# Use compatible Kata genpolicy rules/settings; generation validates their
# supported format and applies the reviewed policy security fixes.
KATA_VERSION="3.29.0"
GENPOLICY="/opt/kata/bin/genpolicy"
RULES="/opt/kata/share/defaults/kata-containers/rules.rego"
SETTINGS="/opt/kata/share/defaults/kata-containers/genpolicy-settings.json"
KEYPROVIDER_IMAGE="ghcr.io/confidential-containers/staged-images/coco-keyprovider@sha256:d694864d215c192c388ffa9645aea19f658fed961925489a1b6709cad201cf73"

# Must match the received launch profile and the participant's CPU/GPU target.
RUNTIME_CLASS="kata-qemu-nvidia-gpu-snp"
WORKLOAD_LAUNCH_PROFILE="${HOME}/coco-inputs/approved-workload-launch-profile.json"
# Optional expected checksum; leave blank to use the received profile directly.
WORKLOAD_LAUNCH_PROFILE_SHA256=""

# Cluster service values embedded in the generated guest execution policy.
KUBERNETES_SERVICE_HOST="10.96.0.1"
KUBERNETES_SERVICE_PORT="443"
