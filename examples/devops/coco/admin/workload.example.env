# Copy this file to a new file for each immutable release.
# Values are shell assignments, not secrets.

# Lowercase DNS label, unique forever for a given image/policy/key tuple.
RELEASE_NAME="coco-demo-REPLACE-WITH-UNIQUE-RELEASE"

# Trusted local build input. Use absolute paths.
BUILD_CONTEXT="${HOME}/coco-admin/example-workload"
DOCKERFILE="${BUILD_CONTEXT}/Dockerfile"

# Lowercase registry repository, without registry host, tag, or digest.
REGISTRY_REPOSITORY="workloads/coco-demo"

# The complete process argv. The first item must be an absolute path. This
# becomes Pod spec.containers[0].command and is enforced by both agent policy
# and the service authorization fragment.
APP_COMMAND_JSON='["/coco-app"]'

# The image must support this fixed non-root identity.
APP_UID="65532"
APP_GID="65532"
