FROM python:3.10
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y install zip

WORKDIR /opt/NVFlare

# Install heavy dependencies first using only the manifest files.
# This layer is cached until setup.py/setup.cfg changes — PyTorch won't
# re-download on every source edit.
COPY setup.py setup.cfg versioneer.py README.md ./
RUN mkdir -p nvflare && touch nvflare/__init__.py
ARG TARGETARCH
# Keep the Linux ARM64 CPU wheels used by Colima. On other architectures,
# retain the normal PT dependencies for hello-pt-docker and pt-ddp-docker.
# Debian's architecture also works with legacy builders without TARGETARCH.
RUN pip install -U pip && \
    if [ "${TARGETARCH:-$(dpkg --print-architecture)}" = "arm64" ]; then \
        pip install -e ".[PT]" "torch==2.5.1" "torchvision==0.20.1" tensorboard; \
    else \
        pip install -e ".[PT]" tensorboard; \
    fi

# Copy real source — only this layer reruns on source changes.
COPY nvflare ./nvflare

# Job containers run with the host UID, which may not exist in this image.
# Keep the original CIFAR-10 cache path writable for those non-root users.
RUN mkdir -p /var/tmp/nvflare/data && chmod 1777 /var/tmp/nvflare/data
