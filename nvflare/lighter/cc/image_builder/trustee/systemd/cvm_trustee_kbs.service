[Unit]
Description=Restricted CVM Trustee KBS
Requires=cvm_key_reconcile.service
After=network-online.target cvm_key_reconcile.service
Wants=network-online.target

[Service]
Type=simple
User=cvm-trustee
Group=cvm-trustee
WorkingDirectory=/opt/cvm-builder
ExecStartPre=/usr/bin/python3 /opt/cvm-builder/scripts/trustee_preflight.py
EnvironmentFile=/etc/cvm-trustee/environment
Environment=RUST_LOG=warn
Environment=XDG_CACHE_HOME=/var/cache/cvm-trustee
CacheDirectory=cvm-trustee
ExecStart=/opt/cvm-trustee/bin/kbs --config-file /etc/cvm-trustee/kbs.json
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/cvm-trustee-resources /etc/cvm-trustee/as-policies
ReadWritePaths=/var/lib/cvm-trustee/as /var/lib/cvm-trustee/policy /var/lib/cvm-trustee/rvps
Restart=on-failure

[Install]
WantedBy=multi-user.target
