[Unit]
Description=Apply permanent CVM key revocations before KBS serves resources
Before=cvm-trustee-kbs.service

[Service]
Type=oneshot
User=cvm-trustee
Group=cvm-trustee
WorkingDirectory=/opt/cvm-builder
ExecStart=/usr/bin/python3 -m builder.key_service /etc/cvm-trustee/key-service.json --reconcile
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cvm-trustee-resources /var/lib/cvm-trustee-revocations
