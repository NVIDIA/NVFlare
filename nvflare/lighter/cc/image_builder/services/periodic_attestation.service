[Unit]
Description=Reappraise the CVM and recheck vault authorization
Requires=cvm_vault.service cvm_integrity.service
After=cvm_vault.service cvm_integrity.service
BindsTo=cvm_integrity.service
PartOf=cvm_workload.target
OnFailure=cvm_fail.service

[Service]
Type=oneshot
WorkingDirectory=/usr/lib/cvm
ExecStart=/usr/bin/python3 -m builder.runtime periodic
LimitMEMLOCK=infinity
LimitCORE=0
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console
