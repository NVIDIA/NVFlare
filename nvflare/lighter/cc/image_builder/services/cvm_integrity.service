[Unit]
Description=Supervise authenticated vault reads
OnFailure=cvm_fail.service
# Deliberately no Requires/After=cvm_vault: bootstrap waits for READY.

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/usr/lib/cvm
ExecStart=/usr/bin/python3 -m builder.integrity
ExecStopPost=/usr/bin/python3 -m builder.runtime fail
TimeoutStartSec=20
WatchdogSec=15
Restart=no
LimitCORE=0
