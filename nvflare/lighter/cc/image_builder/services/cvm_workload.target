[Unit]
Description=Authenticated application workload
Requires=cvm_vault.service cvm_integrity.service
After=cvm_vault.service cvm_integrity.service
BindsTo=cvm_integrity.service
Wants=cvm_app.service mount_user_data.service periodic_attestation.timer
OnFailure=cvm_fail.service
StopWhenUnneeded=no
# Started only by successful bootstrap, never enabled under multi-user.target.
