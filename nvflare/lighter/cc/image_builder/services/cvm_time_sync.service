[Unit]
Description=Synchronize the guest clock before attestation
After=network-online.target chrony.service cvm_firewall.service
Requires=chrony.service cvm_firewall.service
Before=cvm_vault.service
OnFailure=cvm_fail.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/usr/lib/cvm
ExecStart=/usr/bin/python3 -m builder.runtime time-sync
TimeoutStartSec=135
LimitCORE=0

[Install]
WantedBy=multi-user.target
