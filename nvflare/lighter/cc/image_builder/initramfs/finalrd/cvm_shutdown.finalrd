# finalrd's ldd scan misses libraries systemd-shutdown loads with dlopen.
# Include their dependencies too, before PID 1 pivots away from the verified root.
set -eu
[ "${1:-}" = setup ] || exit 0
. /usr/share/initramfs-tools/hook-functions
copy_exec /usr/lib/x86_64-linux-gnu/libmount.so.1
copy_exec /usr/lib/x86_64-linux-gnu/libblkid.so.1
