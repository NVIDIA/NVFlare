+# torchcodec's default num_ffmpeg_threads=0 means "use all cores". Under FL
+# training the decode runs on the main thread (num_workers=0) alongside CUDA
+# and OMP thread pools; on a *shared* SLURM node a noisy neighbour can starve
+# those unbounded ffmpeg threads into an effective deadlock (observed: a single
+# get_frames_at() stuck >10 min, 0% GPU, 155% CPU). Bound it via env so the
+# decoder uses a fixed, modest thread count. 0 preserves upstream behaviour.
+_FFMPEG_THREADS = int(os.environ.get("GROOT_FFMPEG_THREADS", "0") or "0")
