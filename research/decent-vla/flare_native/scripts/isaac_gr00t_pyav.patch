+def _extract_frames_pyav(video_path: str, frame_indices: list[int]) -> np.ndarray:
+    """Decode specific frame indices in-process with PyAV (uses the env FFmpeg).
+    Single-pass sequential decode up to the max requested index; returns NHWC RGB
+    uint8 to match the torchcodec backend. Added so GR00T can decode on systems
+    where torchcodec cannot be built (aarch64/GH200, no CUDA 13)."""
+    import av
+    wanted = [int(i) for i in frame_indices]
+    target = set(wanted)
+    last = max(wanted) if wanted else -1
+    got = {}
+    container = av.open(video_path)
+    try:
+        stream = container.streams.video[0]
+        # Bounded decode threads: AUTO (frame-threading) DEADLOCKS under the GR00T
+        # training loop (same reason torchcodec is capped via GROOT_FFMPEG_THREADS).
+        # Single-threaded is deadlock-free and fast enough for 256x256 clips.
+        stream.thread_count = 1
+        n = 0
+        for frame in container.decode(stream):
+            if n in target:
+                got[n] = frame.to_ndarray(format="rgb24")
+            n += 1
+            if n > last:
+                break
+    finally:
+        container.close()
+    if not got:
+        raise ValueError(f"PyAV decoded no frames from {video_path}")
+    fallback = got[max(got)]
+    return np.stack([got.get(i, fallback) for i in wanted])
+
