---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { researchProjects } from "../data/research";

const baseUrl = import.meta.env.BASE_URL;
const docsBranch = import.meta.env.VITE_PUBLIC_GH_BRANCH || "main";
// This catalog includes projects absent from release branches; examples link to main.
const researchUrl = "https://github.com/NVIDIA/NVFlare/tree/main/research";
const docsUrl = `https://nvflare.readthedocs.io/en/${docsBranch}`;
const highlights = researchProjects.flatMap((project) =>
  project.highlight ? [{ ...project, highlight: project.highlight }] : [],
);
const topics = [
  ...new Set(researchProjects.map((project) => project.topic)),
].sort();
const tools = [
  {
    title: "Build an experiment",
    description:
      "Use recipes to configure common algorithms, or the Client API and Collab API to express custom training and coordination logic.",
    links: [
      {
        label: "Recipe API",
        path: "/user_guide/data_scientist_guide/recipe_api.html",
      },
      {
        label: "Client API",
        path: "/programming_guide/execution_api_type/client_api.html",
      },
      {
        label: "Collab API",
        path: "/user_guide/data_scientist_guide/collab_api.html",
      },
    ],
  },
  {
    title: "Simulate and evaluate",
    description:
      "Run federated clients on one machine with the Simulator, then use POC mode to exercise server and client processes in a local deployment.",
    links: [
      {
        label: "FL Simulator",
        path: "/user_guide/nvflare_cli/fl_simulator.html",
      },
      { label: "POC mode", path: "/user_guide/nvflare_cli/poc_command.html" },
    ],
  },
  {
    title: "Track and compare",
    description:
      "Record metrics with TensorBoard, MLflow, or Weights & Biases, and inspect recipe metrics and artifacts to compare experiments.",
    links: [
      {
        label: "Experiment tracking",
        path: "/programming_guide/experiment_tracking.html",
      },
      {
        label: "Metrics and artifacts",
        path: "/user_guide/data_scientist_guide/recipe_metrics_artifacts.html",
      },
    ],
  },
];
---

<Layout title="Research">
  <main class="research-page">
    <header class="research-hero">
      <div class="page-width">
        <a class="back-link" href={baseUrl}>
          <span aria-hidden="true">&larr;</span> NVIDIA FLARE home
        </a>
        <p class="eyebrow">Research with NVIDIA FLARE</p>
        <h1>
          Explore ideas.
          <br />
          Build federated experiments.
        </h1>
        <p class="hero-description">
          From multimodal foundation models to efficient training and medical
          imaging, explore papers and reference implementations built with
          NVIDIA FLARE.
        </p>
        <nav aria-label="Research page sections" class="section-links">
          <a class="primary-link" href="#highlights">
            Research highlights <span aria-hidden="true">&darr;</span>
          </a>
          <a href="#catalog">Browse all {researchProjects.length} projects</a>
          <a href="#tools">Research tools</a>
        </nav>
        <p class="source-note">
          Based on the <a href={researchUrl}>main-branch research directory</a>.
          Follow each project's README for setup, data, and implementation
          scope.
        </p>
      </div>
    </header>

    <section
      id="highlights"
      class="page-width section"
      aria-labelledby="highlights-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">From the papers</p>
          <h2 id="highlights-title">Research highlights</h2>
        </div>
        <p>
          Selected figures connect the research questions to examples you can
          explore.
        </p>
      </div>
      <div class="highlights">
        {highlights.map((project) => (
          <article class="highlight" id={`highlight-${project.directory}`}>
            <div class="highlight-copy">
              <p class="project-meta">
                {project.topic} <span aria-hidden="true"> / </span>{" "}
                {project.publication}
              </p>
              <p class="project-name">{project.name}</p>
              <h3>{project.highlight.title}</h3>
              <p>{project.highlight.description}</p>
              <p class="example-scope">
                <strong>Explore the example.</strong>{" "}
                {project.highlight.example}
              </p>
              <div class="resource-links">
                <a
                  href={`${researchUrl}/${project.directory}`}
                  aria-label={`Explore ${project.name} example`}>
                  Explore example <span aria-hidden="true">&rarr;</span>
                </a>
                <a
                  href={project.paper}
                  aria-label={`Read paper: ${project.paperTitle}`}>
                  Read paper <span aria-hidden="true">&nearr;</span>
                </a>
              </div>
            </div>
            <figure>
              <a
                class="figure-link"
                href={project.highlight.image.src}
                target="_blank"
                rel="noopener"
                aria-label={`Open full-size ${project.name} figure in a new tab`}>
                <Image
                  src={project.highlight.image}
                  width={Math.min(1400, project.highlight.image.width)}
                  alt={project.highlight.alt}
                  loading="lazy"
                  decoding="async"
                />
                <span class="full-figure">
                  View full figure <span aria-hidden="true">&nearr;</span>
                </span>
              </a>
              <figcaption>
                {project.highlight.caption}
                <a href={project.highlight.figureUrl}>
                  Source: {project.highlight.credit}
                </a>
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section
      id="catalog"
      class="catalog-section section"
      aria-labelledby="catalog-title">
      <div class="page-width">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Find your starting point</p>
            <h2 id="catalog-title">Explore the research catalog</h2>
          </div>
          <p>
            Browse current and foundational work. Examples range from runnable
            jobs to links to the authors' reference code.
          </p>
        </div>
        <div class="catalog-filters" id="catalog-filters" hidden>
          <div class="search-field">
            <label for="research-search">Search projects</label>
            <input
              id="research-search"
              type="search"
              placeholder="Try multimodal, privacy, or CIFAR-10"
              aria-controls="research-projects"
            />
          </div>
          <div>
            <label for="research-topic">Research area</label>
            <select id="research-topic" aria-controls="research-projects">
              <option value="">All areas</option>
              {topics.map((topic) => (
                <option value={topic}>{topic}</option>
              ))}
            </select>
          </div>
        </div>
        <p
          id="research-count"
          class="result-count"
          role="status"
          aria-live="polite">
          {researchProjects.length} projects
        </p>
        <ul id="research-projects" class="project-list">
          {researchProjects.map((project) => (
            <li
              data-project
              data-topic={project.topic}
              data-search={`${project.name} ${project.directory} ${project.topic} ${project.publication} ${project.paperTitle} ${project.summary} ${project.highlight?.description ?? ""} ${project.highlight?.example ?? ""}`.toLowerCase()}>
              <div>
                <h3>
                  <a href={`${researchUrl}/${project.directory}`}>
                    {project.name}
                  </a>
                </h3>
                <p class="catalog-meta">
                  {project.publication} <span aria-hidden="true">·</span>{" "}
                  {project.topic}
                </p>
              </div>
              <p class="project-summary">{project.summary}</p>
              <a
                class="paper-link"
                href={project.paper}
                aria-label={`Read paper: ${project.paperTitle}`}>
                Paper <span aria-hidden="true">&nearr;</span>
              </a>
            </li>
          ))}
        </ul>
        <p id="research-empty" class="empty-state" hidden>
          No projects match. Try another search or choose all research areas.
        </p>
        <div class="support-links">
          <p>
            <strong>Shared data preparation</strong>
            <br />
            <a href={`${researchUrl}/prostate`}>
              Multi-source prostate segmentation data
            </a>{" "}
            supports projects including FedCE and FedSM.
          </p>
          <p>
            <strong>Bring your research</strong>
            <br />
            Start with the{" "}
            <a href={`${researchUrl}/sample-research`}>research template</a> and
            the{" "}
            <a href={`${researchUrl}/CONTRIBUTING.md`}>contribution guide</a>.
          </p>
        </div>
      </div>
    </section>

    <section
      id="tools"
      class="page-width section"
      aria-labelledby="tools-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">From idea to experiment</p>
          <h2 id="tools-title">Research tools</h2>
        </div>
        <p>
          Compose a workflow, simulate a federation, and inspect the results
          with NVIDIA FLARE.
        </p>
      </div>
      <div class="tools-grid">
        {tools.map((tool, index) => (
          <article>
            <span class="tool-number" aria-hidden="true">
              0{index + 1}
            </span>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <ul>
              {tool.links.map((link) => (
                <li>
                  <a href={`${docsUrl}${link.path}`}>
                    {link.label} <span aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="more-research">
        Looking for more? Browse{" "}
        <a href={`${docsUrl}/publications_and_talks.html`}>
          publications and talks
        </a>{" "}
        and the <a href={researchUrl}>full research directory</a>.
      </p>
    </section>
  </main>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>("#catalog-filters");
  const search = document.querySelector<HTMLInputElement>("#research-search");
  const topic = document.querySelector<HTMLSelectElement>("#research-topic");
  const count = document.querySelector<HTMLElement>("#research-count");
  const empty = document.querySelector<HTMLElement>("#research-empty");
  const projects = [
    ...document.querySelectorAll<HTMLElement>("[data-project]"),
  ];

  if (filters && search && topic && count && empty) {
    const filterProjects = () => {
      const terms = search.value
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      let visible = 0;
      for (const project of projects) {
        const matchesSearch = terms.every((term) =>
          project.dataset.search?.includes(term),
        );
        const matchesTopic =
          !topic.value || project.dataset.topic === topic.value;
        project.hidden = !matchesSearch || !matchesTopic;
        if (!project.hidden) visible++;
      }
      count.textContent = `${visible} of ${projects.length} projects`;
      empty.hidden = visible !== 0;
    };
    filters.hidden = false;
    search.addEventListener("input", filterProjects);
    topic.addEventListener("change", filterProjects);
    filterProjects();
  }
</script>

<style>
  .research-page {
    color: #1a202c;
    line-height: 1.65;
  }
  .page-width {
    width: min(1200px, calc(100% - 48px));
    margin-inline: auto;
  }
  .research-page a {
    color: #426b00;
    text-underline-offset: 4px;
  }
  .research-page a:hover {
    text-decoration: underline;
  }
  .research-page :is(a, input, select):focus-visible {
    outline: 3px solid #426b00;
    outline-offset: 5px;
  }
  .research-page [hidden] {
    display: none !important;
  }
  .research-hero {
    padding: 38px 0 58px;
    background: linear-gradient(115deg, #f4f8ee, #fff 75%);
    border-bottom: 1px solid #e2e8d8;
  }
  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: #426b00;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .research-hero .eyebrow {
    margin-top: 52px;
  }
  h1 {
    max-width: 950px;
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }
  .hero-description {
    max-width: 730px;
    margin-top: 24px;
    color: #4b5563;
    font-size: 1.125rem;
  }
  .section-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: 32px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .section-links .primary-link {
    padding: 12px 20px;
    background: #76b900;
    color: #142000;
  }
  .source-note {
    margin-top: 28px;
    max-width: 800px;
    font-size: 0.8125rem;
    color: #59616b;
  }
  .source-note a {
    text-decoration: underline;
  }
  .section {
    padding-block: 64px;
    scroll-margin-top: 24px;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 32px;
  }
  h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }
  .section-heading > p {
    max-width: 400px;
    color: #59616b;
    font-size: 0.9375rem;
  }
  .highlight {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    align-items: center;
    gap: 48px;
    padding-block: 40px;
    border-top: 1px solid #e0e4e8;
  }
  .project-meta {
    color: #59616b;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .project-name {
    margin-top: 14px;
    color: #426b00;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .highlight h3 {
    margin-top: 6px;
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 650;
  }
  .highlight-copy > p:not(.project-meta, .project-name) {
    margin-top: 18px;
    color: #4b5563;
    font-size: 0.9375rem;
  }
  .highlight-copy > .example-scope {
    border-left: 3px solid #c9dfac;
    padding-left: 16px;
  }
  .example-scope strong {
    color: #283421;
    font-weight: 600;
  }
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 22px;
    font-size: 0.875rem;
    font-weight: 650;
  }
  .figure-link {
    display: block;
    padding: 20px;
    background: #fff;
    border: 1px solid #e0e4e8;
    border-radius: 8px;
  }
  .figure-link img {
    width: 100%;
    height: auto;
  }
  .full-figure {
    display: block;
    margin-top: 12px;
    font-size: 0.75rem;
    text-align: right;
  }
  figcaption {
    margin-top: 12px;
    color: #59616b;
    font-size: 0.75rem;
    line-height: 1.6;
  }
  figcaption a {
    display: block;
    text-decoration: underline;
  }
  .catalog-section {
    background: #f6f7f8;
    border-block: 1px solid #e0e4e8;
  }
  .catalog-filters {
    display: flex;
    gap: 24px;
    margin-top: 36px;
  }
  .search-field {
    flex: 1;
  }
  .catalog-filters label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .catalog-filters input,
  .catalog-filters select {
    width: 100%;
    min-height: 46px;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    background: white;
    padding: 10px 14px;
    font: inherit;
    font-size: 0.9375rem;
  }
  .catalog-filters select {
    min-width: 235px;
    padding-right: 36px;
  }
  .result-count {
    margin-block: 22px 12px;
    color: #59616b;
    font-size: 0.8125rem;
  }
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #d5d9de;
  }
  .project-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto;
    gap: 24px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid #d5d9de;
  }
  .project-list h3 {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.4;
  }
  .catalog-meta {
    margin-top: 6px;
    font-size: 0.75rem;
    color: #59616b;
  }
  .project-summary {
    font-size: 0.875rem;
    color: #4b5563;
  }
  .paper-link {
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .empty-state {
    padding-block: 36px;
    color: #4b5563;
  }
  .support-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding-top: 32px;
    font-size: 0.875rem;
    color: #4b5563;
  }
  .support-links strong {
    color: #1a202c;
  }
  .support-links a {
    text-decoration: underline;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: 40px;
  }
  .tools-grid article {
    border-top: 3px solid #76b900;
    padding-top: 20px;
  }
  .tool-number {
    color: #637052;
    font-size: 0.8125rem;
  }
  .tools-grid h3 {
    margin-top: 8px;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .tools-grid p {
    margin-top: 12px;
    color: #4b5563;
    font-size: 0.9375rem;
  }
  .tools-grid ul {
    margin-top: 20px;
    font-size: 0.875rem;
    line-height: 2;
  }
  .more-research {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #e0e4e8;
    color: #59616b;
    font-size: 0.875rem;
  }
  .more-research a {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .highlight {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .section-heading > p {
      max-width: 650px;
    }
    .tools-grid {
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .page-width {
      width: calc(100% - 36px);
    }
    .research-hero {
      padding-block: 24px 40px;
    }
    .research-hero .eyebrow {
      margin-top: 36px;
    }
    .section {
      padding-block: 44px;
    }
    .section-links {
      gap: 16px 24px;
    }
    .highlight {
      padding-block: 32px;
    }
    .figure-link {
      padding: 10px;
    }
    .catalog-filters {
      flex-direction: column;
      gap: 16px;
    }
    .project-list li {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }
    .project-summary {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .support-links,
    .tools-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
