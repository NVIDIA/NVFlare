# NVFlare job runtime image for user training and evaluation workloads.
# The base is NVIDIA's NGC PyTorch image, which includes the GPU framework
# stack. Install NVFlare without the PT extra so pip does not replace the
# tested PyTorch packages that come with the NGC image.
ARG PYTORCH_RUNTIME_BASE=nvcr.io/nvidia/pytorch:26.04-py3

FROM ${PYTORCH_RUNTIME_BASE}

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/NVFlare

# NVFlare launchers commonly use /usr/local/bin/python or python3. The NGC
# PyTorch image provides Python at /usr/bin/python, so add those launcher paths.
RUN --mount=type=bind,source=.,target=/opt/NVFlare,rw \
    git ls-files --deleted -z | git update-index --skip-worktree -z --stdin \
    && python -c "import versioneer; v = versioneer.get_versions(); assert not v['error'], v['error']" \
    && mkdir -p /usr/local/bin \
    && ln -sf /usr/bin/python /usr/local/bin/python \
    && ln -sf /usr/bin/python /usr/local/bin/python3 \
    && python -m pip install --ignore-installed "PyYAML>=6.0" "packaging<=25.0" \
    && NVFL_RELEASE=1 python -m pip install "." \
    && python -c "import importlib.metadata as m; from packaging.version import Version; import nvflare; import torch; import torchvision; metadata_version = m.version('nvflare'); assert metadata_version != '0+unknown' and Version(nvflare.__version__) == Version(metadata_version)"

WORKDIR /app

CMD ["python"]
